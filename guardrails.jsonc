{
  "guardrails": {
    "mode": "hybrid",
    "profile": "development",
    "version": "1.0.0",
    "schemaVersion": "1.0",
    "updated": "2026-09-21T01:05:00Z",

    "strict": {
      // Development mode: no required fields yet
      "requiredFields": [],

      // Remove corruptedCBOR from fatal errors
      "fatalOn": [
        "missingCoreSchema",
        "invalidYAMLC",
        "invalidJSONC",
        "brokenInheritance",
        "missingRequiredFields"
      ]
    },

    "soft": {
      "autoRepair": [
        "missingOptionalFields",
        "missingTimestamps",
        "missingOrigin",
        "missingDescriptions",
        "missingCBOR",
        "missingYAMLC",
        "missingJSONC",
        "missingDefaults"
      ],
      "autoUpdate": [
        "outdatedVersions",
        "mismatchedModuleLists",
        "mismatchedWorkspaceMetadata",
        "mismatchedTemplateMetadata",
        "staleTimestamps"
      ]
    },

    "debug": {
      // Placeholder CBOR will appear here instead of fatal
      "requiresAttention": [
        "malformedSchema",
        "unreadableCBOR",
        "invalidCommentsJSONC",
        "indentationErrorsYAMLC",
        "incompleteInheritanceChain",
        "unexpectedFieldTypes"
      ]
    },

    "defaults": {
      "origin": "DevAiCoreX",
      "description": "Auto-generated by guardrails",
      "updated": "auto"
    },

    "metadata": {
      // Disable metadata validation until metadata exists
      "validateTimestamps": false,
      "validateOrigin": false,
      "validateLineage": false
    },

    "cbor": {
      "generator": "stage7",
      "mode": "placeholder",          // NEW: placeholder mode
      "placeholderHex": "d9d9f7a6",
      "placeholderRecognized": true   // NEW: treat placeholder CBOR as valid placeholder
    },

    // NEW: disable schema checks until guardrail schemas are authored
    "schemaChecksEnabled": false,

    "repairPolicy": {
      "development": "aggressive",
      "production": "conservative",
      "testing": "strict",
      "recovery": "maximum"
    },

    "integration": {
      "manifest": "curated",
      "cli": "selective",
      "creationStation": "curated",
      "aiHandoff": true
    }
  }
}
