# Stage-6.5 Guardrails (Hybrid Mode)
# File: guardrails.yamlc

guardrails:
  mode: hybrid
  profile: development
  version: 1.0.0
  schemaVersion: "1.0"
  updated: 2026-09-21T01:05:00Z

  strict:
    requiredFields:
      - version
      - modules
      - origin
      - updated
    fatalOn:
      - missingCoreSchema
      - corruptedCBOR
      - invalidYAMLC
      - invalidJSONC
      - brokenInheritance
      - missingRequiredFields

  soft:
    autoRepair:
      - missingOptionalFields
      - missingTimestamps
      - missingOrigin
      - missingDescriptions
      - missingCBOR
      - missingYAMLC
      - missingJSONC
      - missingDefaults
    autoUpdate:
      - outdatedVersions
      - mismatchedModuleLists
      - mismatchedWorkspaceMetadata
      - mismatchedTemplateMetadata
      - staleTimestamps

  debug:
    requiresAttention:
      - malformedSchema
      - unreadableCBOR
      - invalidCommentsJSONC
      - indentationErrorsYAMLC
      - incompleteInheritanceChain
      - unexpectedFieldTypes

  defaults:
    origin: DevAiCoreX
    description: "Auto-generated by guardrails"
    updated: auto

  metadata:
    validateTimestamps: true
    validateOrigin: true
    validateLineage: true

  cbor:
    generator: stage7
    mode: headerOnly
    placeholderHex: d9d9f7a6

  repairPolicy:
    development: aggressive
    production: conservative
    testing: strict
    recovery: maximum

  integration:
    manifest: curated
    cli: selective
    creationStation: curated
    aiHandoff: true
